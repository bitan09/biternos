# ── URLs ─────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000

# ── Outbound mail (used for password-reset emails) ────────
SMTP_HOST=
